{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {"source":"/spreadsheet","destination":"/#database","permanent":true},
    {"source":"/finds","destination":"/#database","permanent":true},
    {"source":"/guide","destination":"/#how-it-works","permanent":true},
    {"source":"/usfans-spreadsheet","destination":"/#database","permanent":true},
    {"source":"/usfans-finds","destination":"/#database","permanent":true},
    {"source":"/usfans-agent","destination":"/#how-it-works","permanent":true},
    {"source":"/streetwear-spreadsheet","destination":"/#database","permanent":true},
    {"source":"/maisonlooks-streetstyle","destination":"/#database","permanent":true},
    {"source":"/categories/sneakers","destination":"/#database?category=Sneakers","permanent":true},
    {"source":"/categories/hoodies","destination":"/#database?category=Hoodies","permanent":true},
    {"source":"/categories/jackets","destination":"/#database?category=Jackets","permanent":true},
    {"source":"/categories/denim","destination":"/#database?category=Pants","permanent":true},
    {"source":"/categories/bags","destination":"/#database?category=Bags","permanent":true},
    {"source":"/categories/accessories","destination":"/#database?category=Accessories","permanent":true}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ]
}
