---
import {products as allProducts,categories,categoryName,catalogMeta} from '../data/products';
import ProductPrice from './ProductPrice.astro';
import SiteHeader from './SiteHeader.astro';
import {faq} from '../data/faq';
const { section = 'home' } = Astro.props;
const home = section === 'home';
const products = allProducts;
const pageTitles = {home:'USFans Spreadsheet 2026 | W2C Links & QC Photos',database:'Item Database | USFans Index', 'how-it-works':'How to Use USFans | USFans Index',trust:'Trust & Safety Guide | USFans Index',faq:'Frequently Asked Questions | USFans Index'};
const title = pageTitles[section];
const heading = {database:'Item Database','how-it-works':'How It Works',trust:'Trust & Safety',faq:'Frequently Asked Questions'}[section];
const canonical = new URL(Astro.url.pathname, 'https://usfansindex.com').href;
const descriptions = {database:'Browse item prices, purchase links and source QC photos in the USFans database.','how-it-works':'Learn how to find an item, check QC photos and use a purchase link on USFans.',trust:'Read the USFans safety guide to checking sellers, saving listings and inspecting your order.',faq:'Answers to common questions about the USFans item database, purchase links and QC photos.'};
const homeDescription = 'Browse the USFans Spreadsheet 2026. Compare item prices, open source listings, and check available W2C links and QC photos.';
const description = home ? homeDescription : descriptions[section];
const schema = {'@context':'https://schema.org','@type':'FAQPage','@id':'https://usfansindex.com/faq/',inLanguage:'en',mainEntity:faq.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))};
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title>
<meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
<link rel="icon" href="/usfans-icon.png" type="image/png"/><link rel="apple-touch-icon" href="/usfans-icon.png"/><link rel="stylesheet" href="/styles/global.css"/>
{section === 'faq' && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}
</head><body>
<button class="skip" type="button" data-skip-main>Skip to content</button>
<SiteHeader />
<main id="main-content" tabindex="-1">
{!home && <div class="page-intro"><a class="back-home" href="/">← Home</a><h1>{heading}</h1><p>{description}</p></div>}
{home && <section class="hero" aria-labelledby="hero-title"><div><p class="eyebrow">● &nbsp; THE ITEM DIRECTORY</p><h1 id="hero-title">USFans<br/>Spreadsheet <em>2026.</em></h1><p class="hero-description">Find your next item.<br/>Check the details. Keep the link.</p><a class="button primary hero-cta" href="/database/">Browse Database Now <span aria-hidden="true">↗</span></a><p class="hero-note">Source listings · CNY ≈ USD prices · QC where available</p></div>
<aside class="hero-card" aria-label="Database snapshot"><div class="card-label">IN THE INDEX <span>2026</span></div><div class="index-count">{products.length.toLocaleString('en-US')}<span>source listings</span></div><div class="sample-list">{products.filter((p,i)=>products.findIndex(item=>item.category===p.category)===i).slice(0,3).map((p,i)=><a href={p.sourceUrl} target="_blank" rel="noopener noreferrer"><span class="sample-number">0{i+1}</span><span>{p.name}<small>{categoryName(p.category)}</small></span><ProductPrice cny={p.priceCny}/></a>)}</div><div class="card-label">Browse by category <span aria-hidden="true">↓</span></div></aside></section>}
{(home || section === 'how-it-works') && <section id="how-it-works" class="section"><div class="section-heading"><p class="eyebrow">FROM FIND TO CHECKOUT</p><h2>Four steps. You're in.</h2></div><ol class="steps">{[['Find Item','Search the database or choose a category.'],['Check QC','Inspect photos of your own order.'],['Copy W2C','Copy the purchase link, when available.'],['Paste in USFans','Import the link and confirm item details.']].map(([name,text],i)=><li><span class="step-number">0{i+1}</span><h3>{name}</h3><p>{text}</p></li>)}</ol></section>}
{home && <section class="section" aria-labelledby="categories-title"><div class="section-heading"><p class="eyebrow">YOUR NEXT FIND</p><h2 id="categories-title">Browse Items</h2></div><nav class="category-grid" aria-label="Product categories">{categories.map(c=><a href={`/categories/${c.slug}/`} data-category={c.slug}>{c.name}<span class="category-count">{c.count.toLocaleString("en-US")}</span><span aria-hidden="true">↗</span></a>)}</nav></section>}
{home && <section class="section updates"><div><p class="eyebrow">FRESHNESS, AT A GLANCE</p><h2>Latest Updates</h2><p><time datetime={catalogMeta.collectedAt}>{new Date(catalogMeta.collectedAt).toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric",timeZone:"Asia/Shanghai"})}</time> · {products.length} source listings across {categories.length} categories.</p><p class="muted">A daily refresh schedule is not yet active.</p></div><div id="archive"><p class="eyebrow">LOOKING BACK</p><h2>2025 Archive</h2><p>No verified 2025 archive is available yet.</p></div></section>}
{section === 'trust' && <section id="trust" class="section"><div class="section-heading"><p class="eyebrow">BEFORE YOU BUY</p><h2>Trust &amp; Safety Guide</h2></div><div class="trust-grid"><article><h3>How to avoid bait &amp; switch</h3><ol><li><h4>Check recent evidence</h4><p>Compare feedback for the exact seller, variant, and claimed batch. Labels such as “1:1” are seller claims, not quality certifications.</p></li><li><h4>Save the listing</h4><p>Keep screenshots of the item, size, color, price, return terms, and order messages.</p></li><li><h4>Inspect your own order</h4><p>Compare warehouse photos with your saved listing. Request missing views and resolve mismatches before approving shipping. Check return deadlines promptly.</p></li></ol></article><article><h3>Always check QC photos</h3><p>Other buyers' photos are references, not evidence of what you received. Check your own order before international shipping.</p><ul><li>Match model, size label, color, and quantity.</li><li>Look for damage, uneven seams, and missing parts.</li><li>Request measurements and close-ups when needed.</li></ul><p class="muted">Photos cannot prove authenticity, product safety, material composition, or long-term durability.</p><h3>Disclaimer</h3><p>USFans Index is a data organization tool. We do not sell products, accept product payments, fulfill orders, or perform physical inspections. All transactions take place on USFans or other third-party platforms.</p><p>Listings are not endorsements or guarantees. Contact the platform or seller handling your order for returns and refunds.</p></article></div></section>}
{section === 'faq' && <section id="faq" class="section"><div class="section-heading"><p class="eyebrow">A FEW USEFUL ANSWERS</p><h2>USFans Spreadsheet FAQ</h2></div>{faq.map(f=><details class="faq-item"><summary><h3>{f.question}</h3></summary><p>{f.answer}</p></details>)}</section>}
</main><footer><a class="wordmark" href="/"><img class="brand-icon" src="/usfans-icon.png" alt="USFans spreadsheet" width="40" height="40"/>USFANS<span>INDEX</span></a><p>A place to find items. Your purchases stay with the seller.</p><a href="/trust/">Trust &amp; safety</a><a href="/faq/">FAQ</a></footer>
<div id="toast" role="status" aria-live="polite" hidden></div><dialog id="manual-dialog" aria-labelledby="manual-title"><h2 id="manual-title">Copy this link</h2><p>Automatic copying is unavailable. Select and copy the link below.</p><label>Link<input id="manual-link" readonly/></label><form method="dialog"><button class="button primary">Done</button></form></dialog>
</body></html>
