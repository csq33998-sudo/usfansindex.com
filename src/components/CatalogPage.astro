---
import SiteHeader from './SiteHeader.astro';
import ProductCard from './ProductCard.astro';
import {categories,products,productsByCategory,pageSize,catalogPath,catalogMeta} from '../data/products';
const {categorySlug='',pageNumber=1}=Astro.props;
const category=categories.find(c=>c.slug===categorySlug);
const items=categorySlug ? productsByCategory.get(categorySlug)! : products;
const pages=Math.ceil(items.length/pageSize);
const pageItems=items.slice((pageNumber-1)*pageSize,pageNumber*pageSize);
const heading=category?.name||'All Products';
const title=`${heading}${pageNumber>1?' — Page '+pageNumber:''} | USFans Index`;
const description=category ? category.description+' Browse '+items.length.toLocaleString('en-US')+' source listings, images and prices.' : 'Explore the complete Street Style / MaisonLooks product directory, organized by category. Search products and compare source prices.';
const canonical=new URL(catalogPath(categorySlug,pageNumber),'https://usfansindex.com').href;
const nearby=[...new Set([1,...Array.from({length:5},(_,i)=>pageNumber-2+i).filter(n=>n>1&&n<pages),pages])].sort((a,b)=>a-b);
const subcategories=[...new Set(items.map(p=>p.sourceCategory))].sort();
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" href="/usfans-icon.png"/><link rel="stylesheet" href="/styles/global.css"/></head>
<body><button class="skip" type="button" data-skip-main>Skip to content</button><SiteHeader/>
<main id="main-content" class="catalog-main" tabindex="-1" data-catalog={categorySlug||'all'} data-page={pageNumber} data-page-size={pageSize}>
 <div class="catalog-intro"><div><div class="breadcrumbs"><a href="/">Home</a><span aria-hidden="true">/</span>{category ? <><a href="/database/">All products</a><span aria-hidden="true">/</span><span>{heading}</span></> : <span>All products</span>}</div><p class="eyebrow">THE ITEM DIRECTORY</p><h1>{heading}</h1><p>{description}</p></div><div class="catalog-total"><strong class="notranslate" translate="no">{items.length.toLocaleString('en-US')}</strong><span>source listings</span></div></div>
 <div class="catalog-layout"><aside class="catalog-sidebar"><details open><summary>Categories</summary><nav aria-label="Browse product categories"><a href="/database/" aria-current={!category?'page':undefined}><span>All products</span><small>{products.length.toLocaleString('en-US')}</small></a>{categories.map(c=><a href={catalogPath(c.slug)} aria-current={c.slug===categorySlug?'page':undefined}><span>{c.name}</span><small>{c.count.toLocaleString('en-US')}</small></a>)}</nav></details><p class="catalog-provenance">Source directory<br/><a href="https://streetstyle.maisonlooks.com/" target="_blank" rel="noopener noreferrer">Street Style / MaisonLooks ↗</a></p></aside>
 <section class="catalog-content" aria-label="Products"><form class="catalog-controls" id="catalog-search" role="search"><label class="catalog-search"><span>Search products</span><input id="search" name="q" type="search" placeholder="Search products or brands…" autocomplete="off"/><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="m15 15 6 6"/></svg></label><label><span>Product type</span><select id="product-type" name="type"><option value="">All types</option>{subcategories.map(c=><option value={c}>{c}</option>)}</select></label><label><span>Sort by</span><select id="sort" name="sort"><option value="source">Source order</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option><option value="name">Name: A–Z</option></select></label><button class="catalog-reset" type="reset">Reset</button><noscript><p>Category links and page navigation work without JavaScript. Enable JavaScript for search and sorting.</p></noscript></form>
 <div class="catalog-results-line"><p id="results" role="status" aria-live="polite">Showing {(pageNumber-1)*pageSize+1}–{Math.min(pageNumber*pageSize,items.length)} of {items.length.toLocaleString('en-US')} items</p><span>Prices in CNY · USD estimate</span></div>
 <div id="catalog-error" class="catalog-error" role="alert" hidden>Could not load the search catalog. Your current page is still available. <button type="button" id="retry-search">Try again</button></div>
 <h2 class="sr-only">Products</h2><div id="catalog-grid" class="catalog-grid">{pageItems.map(p=><ProductCard product={p}/>)}</div>
 <div id="catalog-empty" class="empty" hidden><h2>No matching products</h2><p>Try a different name or clear the filters.</p><button type="button" class="button secondary" id="clear-search">Clear filters</button></div>
 <nav id="catalog-pagination" class="catalog-pagination" aria-label="Product pages">{pageNumber > 1 && <a class="page-direction" href={catalogPath(categorySlug,pageNumber-1)} rel="prev">← Previous</a>}<div class="page-numbers">{nearby.map((n,i)=><>{i>0&&n-nearby[i-1]>1&&<span aria-hidden="true">…</span>}<a href={catalogPath(categorySlug,n)} aria-label={`Page ${n}`} aria-current={n===pageNumber?'page':undefined}>{n}</a></>)}</div>{pageNumber < pages && <a class="page-direction" href={catalogPath(categorySlug,pageNumber+1)} rel="next">Next →</a>}</nav>
 <p class="data-note">Source snapshot: <time datetime={catalogMeta.collectedAt}>{new Date(catalogMeta.collectedAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'Asia/Shanghai'})}</time>. Source prices and availability may change. USD estimates use ¥7.20 per $1 and exclude shipping and fees. Open an item to check its current purchase link and available QC on the source site. QC references may show other variants; inspect your own order.</p></section></div>
</main><footer><a class="wordmark" href="/">USFANS<span>INDEX</span></a><p>A place to find items. Your purchases stay with the seller.</p><a href="/trust/">Trust &amp; safety</a><a href="/faq/">FAQ</a></footer>
<div id="toast" role="status" aria-live="polite" hidden></div><dialog id="manual-dialog" aria-labelledby="manual-title"><h2 id="manual-title">Copy this link</h2><label>Link<input id="manual-link" readonly/></label><form method="dialog"><button class="button primary">Done</button></form></dialog>
<dialog class="qc-dialog" id="catalog-qc-dialog" aria-labelledby="catalog-qc-title"><form method="dialog" class="qc-close"><button class="button secondary" aria-label="Close QC gallery">Close ×</button></form><p class="eyebrow">SOURCE QC REFERENCES</p><h2 id="catalog-qc-title"></h2><p>Photos associated with the source listing may show other variants. They are not photos of your order.</p><div class="qc-grid" id="catalog-qc-photos"></div></dialog>
<script src="/scripts/catalog.js" is:inline defer></script></body></html>
