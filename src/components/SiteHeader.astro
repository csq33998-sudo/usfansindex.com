---
import LanguagePicker from './LanguagePicker.astro';
import {categories,products} from '../data/products';
---
<header class="site-header">
 <a class="wordmark notranslate" translate="no" href="/"><img class="brand-icon" src="/usfans-icon.png" alt="USFans spreadsheet" width="40" height="40"/>USFANS<span>INDEX</span><i></i></a>
 <nav class="main-nav" aria-label="Main navigation"><div class="categories-picker">
  <button class="categories-toggle" type="button" aria-expanded="false" aria-controls="categories-panel"><svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 2h6v6H2zm10 0h6v6h-6zM2 12h6v6H2zm10 0h6v6h-6z"/></svg>Categories <span class="categories-chevron" aria-hidden="true">⌄</span></button>
  <div id="categories-panel" class="categories-panel" hidden><div class="categories-panel-heading"><span>Browse by category</span><span>{categories.length} categories</span></div>
   <div class="categories-menu-links">{categories.map(c=><a href={`/categories/${c.slug}/`} aria-current={Astro.url.pathname.startsWith(`/categories/${c.slug}/`)?'page':undefined}><span>{c.name}</span><small class="notranslate" translate="no">{c.count.toLocaleString('en-US')}</small></a>)}</div>
   <a class="categories-all" href="/database/">All products <span>{products.length.toLocaleString('en-US')} ↗</span></a>
  </div></div><a href="/how-it-works/">How it works</a><a href="/trust/">Trust &amp; safety</a></nav><span class="edition">2026 EDITION</span><LanguagePicker />
</header>

<script src="/scripts/navigation.js" is:inline defer></script>
