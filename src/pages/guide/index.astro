---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { MAISONLOOKS_URL, guides } from "../../data/site";
---
<BaseLayout title="USFans Guide - How to Build a Better Streetwear Haul">
  <Header />
  <main id="main" class="page">
    <section class="page-head">
      <p class="eyebrow" data-i18n="navGuide">Guide</p>
      <h1 data-i18n="guideTitle">How to use a USFans spreadsheet without getting lost in links.</h1>
      <p data-i18n="guideIntro">Give search visitors a simple path: scan the category, compare the notes, check QC, and keep the haul list organized.</p>
    </section>
    <section class="guide-steps">
      {guides.map((guide, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h2 data-i18n={`guideStep${index + 1}Title`}>{guide}</h2>
          <p data-i18n="guideStepText">Keep the page focused on intent, sizing, QC, and agent-ready decision making.</p>
        </article>
      ))}
    </section>
    <a class="button primary" href={MAISONLOOKS_URL} target="_blank" rel="noopener noreferrer" data-i18n="startMaisonLooks">Start with MaisonLooks</a>
  </main>
  <Footer />
</BaseLayout>
