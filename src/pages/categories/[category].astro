---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { MAISONLOOKS_URL, categories, finds } from "../../data/site";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const categoryFinds = finds
  .map((item, index) => ({ ...item, i18nIndex: index + 1 }))
  .filter((item) => item.category === category.name);
const categoryIndex = categories.findIndex((item) => item.slug === category.slug);
---
<BaseLayout title={`${category.name} Finds - USFans Index`}>
  <Header />
  <main id="main" class="page">
    <section class="page-head">
      <p class="eyebrow" data-i18n="tableCategory">Category</p>
      <h1 data-i18n={`category${categoryIndex + 1}PageTitle`}>{category.name} finds for USFans shoppers.</h1>
      <p data-i18n="categoryPageIntro">Focused picks and buying notes for agent-friendly streetwear discovery.</p>
      <a class="button primary" href={category.maisonlooksUrl} target="_blank" rel="noopener noreferrer">
        <span data-i18n="searchCategoryPrefix">Search</span> <span data-i18n={`find${categoryIndex + 1}Category`}>{category.name}</span> <span data-i18n="searchCategorySuffix">on MaisonLooks</span>
      </a>
    </section>
    <section class="cards page-cards">
      {categoryFinds.map((item) => (
        <article class="card">
          <span data-i18n={`find${item.i18nIndex}Category`}>{item.category}</span>
          <h2 data-i18n={`find${item.i18nIndex}Title`}>{item.title}</h2>
          <p data-i18n={`find${item.i18nIndex}Note`}>{item.note}</p>
          <strong>{item.price}</strong>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</BaseLayout>
