---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { articles } from "../../data/articles";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const relatedArticles = articles
  .filter((item) => item.slug !== article.slug)
  .slice(0, 3);
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  keywords: article.keyword,
  author: {
    "@type": "Organization",
    name: "USFans Index",
  },
  publisher: {
    "@type": "Organization",
    name: "USFans Index",
  },
};
---
<BaseLayout title={article.title} description={article.description} schema={schema}>
  <Header />
  <main id="main" class="page article-page">
    <article class="article-body">
      <p class="eyebrow" data-i18n={`article.${article.slug}.keyword`}>{article.keyword}</p>
      <h1 data-i18n={`article.${article.slug}.title`}>{article.title}</h1>
      <p class="article-intro" data-i18n={`article.${article.slug}.intro`}>{article.intro}</p>
      <div class="article-meta">
        <span data-i18n={`article.${article.slug}.category`}>{article.category}</span>
        <span data-i18n={`article.${article.slug}.readTime`}>{article.readTime}</span>
      </div>
      {article.sections.map((section, index) => (
        <section>
          <h2 data-i18n={`article.${article.slug}.section${index + 1}Heading`}>{section.heading}</h2>
          <p data-i18n={`article.${article.slug}.section${index + 1}Body`}>{section.body}</p>
        </section>
      ))}
      <div class="article-cta">
        <p data-i18n="articleCtaText">
          Continue from this USFans spreadsheet guide with matching streetwear finds,
          W2C links, QC-aware browsing, and agent-ready category discovery.
        </p>
        <a class="button primary" href={article.ctaUrl} target="_blank" rel="noopener noreferrer" data-i18n={`article.${article.slug}.cta`}>{article.cta}</a>
      </div>
    </article>

    <aside class="related-articles" aria-label="Related articles">
      <h2 data-i18n="relatedArticlesTitle">Related USFans guides</h2>
      {relatedArticles.map((item) => (
        <a href={`/articles/${item.slug}/`}>
          <span data-i18n={`article.${item.slug}.keyword`}>{item.keyword}</span>
          <strong data-i18n={`article.${item.slug}.title`}>{item.title}</strong>
        </a>
      ))}
    </aside>
  </main>
  <Footer />
</BaseLayout>
