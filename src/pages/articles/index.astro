---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { articles } from "../../data/articles";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "USFans Spreadsheet Articles",
  description:
    "SEO articles for USFans spreadsheet, USFans finds, W2C streetwear, agent links, QC checks, and streetwear haul searches.",
};
---
<BaseLayout
  title="USFans Spreadsheet Articles - Finds, W2C Links & Agent Shopping Guides"
  description="Read USFans spreadsheet articles for W2C streetwear links, agent shopping workflows, QC checklists, category guides, and organized haul research."
  schema={schema}
>
  <Header />
  <main id="main" class="page">
    <section class="page-head">
      <p class="eyebrow" data-i18n="navArticles">Articles</p>
      <h1 data-i18n="articlesPageTitle">USFans spreadsheet articles for streetwear search intent.</h1>
      <p data-i18n="articlesPageIntro">
        Guides written around USFans spreadsheet, USFans finds, W2C streetwear,
        agent shopping links, QC checks, category spreadsheets, and organized haul research.
      </p>
    </section>
    <section class="article-grid">
      {articles.map((article) => (
        <article class="article-card">
          <span data-i18n={`article.${article.slug}.category`}>{article.category}</span>
          <h2><a href={`/articles/${article.slug}/`} data-i18n={`article.${article.slug}.title`}>{article.title}</a></h2>
          <p data-i18n={`article.${article.slug}.description`}>{article.description}</p>
          <small><span data-i18n={`article.${article.slug}.keyword`}>{article.keyword}</span> - <span data-i18n={`article.${article.slug}.readTime`}>{article.readTime}</span></small>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</BaseLayout>

