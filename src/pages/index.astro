---
import {products,categories} from '../data/products';
import {faq} from '../data/faq';
const description = 'Browse the USFans Spreadsheet 2026. Compare item prices, open source listings, and check available W2C links and QC photos.';
const schema = {'@context':'https://schema.org','@type':'FAQPage','@id':'https://usfansindex.com/#faq',inLanguage:'en',mainEntity:faq.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))};
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>USFans Spreadsheet 2026 | W2C Links &amp; QC Photos</title>
<meta name="description" content={description}/><link rel="canonical" href="https://usfansindex.com/"/>
<meta property="og:title" content="USFans Spreadsheet 2026 | W2C Links & QC Photos"/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="stylesheet" href="/styles/global.css"/>
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</head><body>
<a class="skip" href="#database">Skip to database</a>
<header class="site-header"><a class="wordmark" href="/">USFANS<span>INDEX</span><i></i></a><nav aria-label="Main navigation"><a href="#database">Database</a><a href="#how-it-works">How it works</a><a href="#trust">Trust &amp; safety</a></nav><span class="edition">2026 EDITION</span></header>
<main>
<section class="hero" aria-labelledby="hero-title"><div><p class="eyebrow">● &nbsp; THE ITEM DIRECTORY</p><h1 id="hero-title">USFans<br/>Spreadsheet <em>2026.</em></h1><p class="hero-description">Find your next item.<br/>Check the details. Keep the link.</p><a class="button primary hero-cta" href="#database">Browse Database Now <span aria-hidden="true">↗</span></a><p class="hero-note">Source listings · Prices in CNY · QC where available</p></div>
<aside class="hero-card" aria-label="Database snapshot"><div class="card-label">IN THE INDEX <span>2026</span></div><div class="index-count">{products.length.toString().padStart(2,'0')}<span>source listings</span></div><div class="sample-list">{products.filter((p,i)=>products.findIndex(item=>item.category===p.category)===i).slice(0,3).map((p,i)=><a href={p.sourceUrl} target="_blank" rel="noopener noreferrer"><span class="sample-number">0{i+1}</span><span>{p.name}<small>{p.category}</small></span><strong>¥{p.priceCny}</strong></a>)}</div><div class="card-label">Browse by category <span aria-hidden="true">↓</span></div></aside></section>
<section id="how-it-works" class="section"><div class="section-heading"><p class="eyebrow">FROM FIND TO CHECKOUT</p><h2>Four steps. You're in.</h2></div><ol class="steps">{[['Find Item','Search the database or choose a category.'],['Check QC','Inspect photos of your own order.'],['Copy W2C','Copy the purchase link, when available.'],['Paste in USFans','Import the link and confirm item details.']].map(([name,text],i)=><li><span class="step-number">0{i+1}</span><h3>{name}</h3><p>{text}</p></li>)}</ol></section>
<section class="section" aria-labelledby="categories-title"><div class="section-heading"><p class="eyebrow">YOUR NEXT FIND</p><h2 id="categories-title">Browse Items</h2></div><nav class="category-grid" aria-label="Product categories">{categories.map(name=><a href={`#database?category=${encodeURIComponent(name)}`} data-category={name}>{name}<span class="category-count">{products.filter(p=>p.category===name).length}</span><span aria-hidden="true">↗</span></a>)}</nav></section>
<section id="database" class="section" aria-labelledby="database-title"><div class="section-heading database-heading"><div><p class="eyebrow">THE DATABASE</p><h2 id="database-title">W2C Links &amp; QC Photos</h2></div><span class="source-pill">Source: Street Style / MaisonLooks</span></div>
<div class="controls"><label class="search-label"><span>Search items</span><input id="search" type="search" placeholder="Try sneakers, hoodie, or a brand…" autocomplete="off" aria-controls="product-table"/></label><label><span>Category</span><select id="category" aria-controls="product-table"><option value="">All categories</option>{categories.map(name=><option>{name}</option>)}</select></label><label><span>Currency</span><select id="currency"><option value="CNY">CNY · ¥</option><option value="USD">USD · $ estimate</option></select></label><button id="reset" class="button secondary" type="button">Reset</button></div>
<div class="table-meta"><p id="results" role="status" aria-live="polite">{products.length} items</p><p>Swipe table to see all columns ↔</p></div>
<div class="table-scroll" tabindex="0" role="region" aria-label="Item database. Scroll horizontally to see all columns."><table id="product-table"><caption class="sr-only">Item name, category, batch, estimated price, QC photos and purchase link</caption><thead><tr>{['Item Name','Category','Batch / Quality','Price (Est.)','QC Photos','W2C Link'].map(name=><th scope="col">{name}</th>)}</tr></thead><tbody>
{products.map(p=><tr data-name={`${p.name} ${p.category} ${p.batch || ''}`.toLowerCase()} data-category={p.category}>
<td><div class="product-cell"><img src={p.imageUrl} alt="" width="56" height="64" loading="lazy" decoding="async" referrerpolicy="no-referrer"/><a class="product-name" href={p.sourceUrl} target="_blank" rel="noopener noreferrer">{p.name}<span>View source listing ↗</span></a></div></td><td><button class="tag" type="button" data-filter={p.category} aria-pressed="false">{p.category}</button></td>
<td><span class="unavailable">{p.batch || 'Not provided'}</span></td><td class="price" data-cny={p.priceCny}>¥{p.priceCny.toFixed(2)}<small>CNY</small></td>
<td>{p.qcUrl ? <a class="button secondary" href={p.qcUrl} data-gallery={`qc-${p.id}`} target="_blank" rel="noopener noreferrer" aria-label={`View QC photos for ${p.name}`}>▧ View QC ({p.qcPhotos.length})</a> : <span class="unavailable">Not provided</span>}</td>
<td>{p.w2cUrl ? <button type="button" class="button copy" data-copy={p.w2cUrl} aria-label={`Copy W2C link for ${p.name}`}>Copy Link</button> : <span class="unavailable">Not provided</span>}<button type="button" class="source-copy" data-copy={p.sourceUrl} aria-label={`Copy source page for ${p.name}`}>Copy source page</button></td></tr>)}
</tbody></table></div><nav id="pagination" class="pagination" aria-label="Product pages" hidden><button id="previous-page" class="button secondary" type="button">← Previous</button><span id="page-status" role="status" aria-live="polite"></span><button id="next-page" class="button secondary" type="button">Next →</button></nav><div id="empty" class="empty" hidden><h3>No matching items</h3><p>Try a different search or clear your filters.</p><button class="button secondary" type="button" data-reset>Clear filters</button></div>
<p class="data-note">Source snapshot: September 14, 2026. Prices may change. USD uses an illustrative rate of ¥7.20 per $1; shipping and fees are excluded. QC images are references associated with the source listing and may show other variants. Inspect your own order before shipping. Some purchase links include multiple styles; select the named variant on the agent page. Batch information was not provided. <a href="https://streetstyle.maisonlooks.com/" target="_blank" rel="noopener noreferrer">Check the source ↗</a></p><noscript><p>All items are shown. Enable JavaScript to search, filter, and copy links.</p></noscript></section>
<section class="section updates"><div><p class="eyebrow">FRESHNESS, AT A GLANCE</p><h2>Latest Updates</h2><p><time datetime="2026-09-14">September 14, 2026</time> · {products.length} source listings across {categories.length} categories.</p><p class="muted">A daily refresh schedule is not yet active.</p></div><div id="archive"><p class="eyebrow">LOOKING BACK</p><h2>2025 Archive</h2><p>No verified 2025 archive is available yet.</p></div></section>
<section id="trust" class="section"><div class="section-heading"><p class="eyebrow">BEFORE YOU BUY</p><h2>Trust &amp; Safety Guide</h2></div><div class="trust-grid"><article><h3>How to avoid bait &amp; switch</h3><ol><li><h4>Check recent evidence</h4><p>Compare feedback for the exact seller, variant, and claimed batch. Labels such as “1:1” are seller claims, not quality certifications.</p></li><li><h4>Save the listing</h4><p>Keep screenshots of the item, size, color, price, return terms, and order messages.</p></li><li><h4>Inspect your own order</h4><p>Compare warehouse photos with your saved listing. Request missing views and resolve mismatches before approving shipping. Check return deadlines promptly.</p></li></ol></article><article><h3>Always check QC photos</h3><p>Other buyers' photos are references, not evidence of what you received. Check your own order before international shipping.</p><ul><li>Match model, size label, color, and quantity.</li><li>Look for damage, uneven seams, and missing parts.</li><li>Request measurements and close-ups when needed.</li></ul><p class="muted">Photos cannot prove authenticity, product safety, material composition, or long-term durability.</p><h3>Disclaimer</h3><p>USFans Index is a data organization tool. We do not sell products, accept product payments, fulfill orders, or perform physical inspections. All transactions take place on USFans or other third-party platforms.</p><p>Listings are not endorsements or guarantees. Contact the platform or seller handling your order for returns and refunds.</p></article></div></section>
<section id="faq" class="section"><div class="section-heading"><p class="eyebrow">A FEW USEFUL ANSWERS</p><h2>USFans Spreadsheet FAQ</h2></div>{faq.map(f=><details class="faq-item"><summary><h3>{f.question}</h3></summary><p>{f.answer}</p></details>)}</section>
</main><footer><a class="wordmark" href="/">USFANS<span>INDEX</span></a><p>A place to find items. Your purchases stay with the seller.</p><a href="#trust">Trust &amp; safety</a><a href="#faq">FAQ</a></footer>
<div id="toast" role="status" aria-live="polite" hidden></div><dialog id="manual-dialog" aria-labelledby="manual-title"><h2 id="manual-title">Copy this link</h2><p>Automatic copying is unavailable. Select and copy the link below.</p><label>Link<input id="manual-link" readonly/></label><form method="dialog"><button class="button primary">Done</button></form></dialog>
{products.map(p=><dialog class="qc-dialog" id={`qc-${p.id}`} aria-labelledby={`qc-title-${p.id}`}><form method="dialog" class="qc-close"><button class="button secondary" aria-label="Close QC gallery">Close ×</button></form><p class="eyebrow">SOURCE QC REFERENCES</p><h2 id={`qc-title-${p.id}`}>{p.name}</h2><p>Photos associated with the source listing may show other variants. They are not photos of your order.</p><div class="qc-grid">{p.qcPhotos.map((url,i)=><a href={url} target="_blank" rel="noopener noreferrer"><img src={url} alt={`Source QC reference ${i+1} for ${p.name}`} loading="lazy" decoding="async" referrerpolicy="no-referrer"/><span>Open photo {i+1} ↗</span></a>)}</div><a class="source-link" href={p.sourceUrl} target="_blank" rel="noopener noreferrer">View original source listing ↗</a></dialog>)}
<script src="/scripts/site.js" is:inline defer></script></body></html>
