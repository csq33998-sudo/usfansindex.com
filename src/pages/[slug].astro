---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { MAISONLOOKS_URL, categories, finds } from "../data/site";
import { buildSeoSchema, seoPages } from "../data/seo-pages";

export function getStaticPaths() {
  return seoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const schema = buildSeoSchema(page);
---
<BaseLayout title={page.title} description={page.description} schema={schema}>
  <Header />
  <main id="main" class="page">
    <section class="page-head seo-head">
      <p class="eyebrow" data-i18n={`seo.${page.slug}.keyword`}>{page.keyword}</p>
      <h1 data-i18n={`seo.${page.slug}.h1`}>{page.h1}</h1>
      <p data-i18n={`seo.${page.slug}.intro`}>{page.intro}</p>
      <a class="button primary" href={MAISONLOOKS_URL} target="_blank" rel="noopener noreferrer" data-i18n="continueMaisonLooks">Continue on MaisonLooks</a>
    </section>

    <section class="seo-grid" aria-label="Keyword topics">
      <article class="seo-block">
        <h2 data-i18n="bestCategories">Best categories for this search</h2>
        <div class="keyword-cloud">
          {categories.map((category, index) => (
            <a href={category.maisonlooksUrl} target="_blank" rel="noopener noreferrer">
              <span data-i18n={`find${index + 1}Category`}>{category.name}</span> <span data-i18n="findsSuffix">finds</span>
            </a>
          ))}
        </div>
      </article>
      <article class="seo-block">
        <h2 data-i18n="relatedSearches">Related searches</h2>
        <div class="keyword-cloud">
          {page.related.map((keyword, index) => <span data-i18n={`seo.${page.slug}.related${index + 1}`}>{keyword}</span>)}
        </div>
      </article>
    </section>

    <section class="section compact-section">
      <div class="section-head">
        <p class="eyebrow" data-i18n="matchedLists">Matched lists</p>
        <h2><span data-i18n="matchedListsTitlePrefix">Streetwear finds aligned with</span> <span data-i18n={`seo.${page.slug}.keyword`}>{page.keyword}</span></h2>
      </div>
      <div class="cards">
        {finds.slice(0, 3).map((item, index) => (
          <article class="card">
            <span data-i18n={`find${index + 1}Category`}>{item.category}</span>
            <h3 data-i18n={`find${index + 1}Title`}>{item.title}</h3>
            <p data-i18n={`find${index + 1}Note`}>{item.note}</p>
            <strong>{item.price}</strong>
            <a href={item.maisonlooksUrl} target="_blank" rel="noopener noreferrer" data-i18n="searchRelatedItems">Search related items</a>
          </article>
        ))}
      </div>
    </section>

    <section class="faq">
      <h2 data-i18n="faqTitle">Questions shoppers search before using an agent</h2>
      <details open>
        <summary data-i18n="faqOneQ">Is this a USFans spreadsheet replacement?</summary>
        <p data-i18n="faqOneA">It works as a search-friendly index for USFans spreadsheet queries, with category pages, W2C notes, QC context, and agent shopping guidance.</p>
      </details>
      <details>
        <summary data-i18n="faqTwoQ">What keywords does this page target?</summary>
        <p><span data-i18n="faqTwoPrefix">This page targets</span> <span data-i18n={`seo.${page.slug}.keyword`}>{page.keyword}</span><span data-i18n="faqTwoSuffix">, plus related W2C, agent, streetwear finds, spreadsheet, sneakers, hoodie, jacket, denim, bag, and accessory searches.</span></p>
      </details>
      <details>
        <summary data-i18n="faqThreeQ">How should shoppers use this index?</summary>
        <p data-i18n="faqThreeA">Use this index to understand a USFans spreadsheet query, compare category notes, and keep agent-ready haul research organized.</p>
      </details>
    </section>
  </main>
  <Footer />
</BaseLayout>
