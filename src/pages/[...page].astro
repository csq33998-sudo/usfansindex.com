---
import SitePage from '../components/SitePage.astro';
import {categories} from '../data/products';
export function getStaticPaths() {
 return [
  ...['database','how-it-works','trust','faq'].map(section => ({params:{page:section},props:{section}})),
  ...categories.map(name => ({params:{page:'categories/'+name.toLowerCase()},props:{section:'database',selectedCategory:name}})),
 ];
}
---
<SitePage {...Astro.props} />
